{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "useUnknownInCatchVariables": false,
    "types": ["vitest/globals", "node"]
  },
  "ts-node": {
    "swc": true,
    "esm": true,
    "experimentalResolver":true
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "prisma.config.ts",
    "scripts",
    "eslint.config.ts",
    "vitest.config.mts"
  ],
  "exclude": ["src/public/*"]
}
